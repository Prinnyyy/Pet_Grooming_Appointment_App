<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24500" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24500"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchWash" translatesAutoresizingMaskIntoConstraints="NO" id="launch-wash"/>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchLockup" translatesAutoresizingMaskIntoConstraints="NO" id="launch-lockup">
                                <constraints>
                                    <constraint firstAttribute="width" constant="345" priority="999" id="brand-width"/>
                                    <constraint firstAttribute="height" constant="408" id="brand-height"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe"/>
                        <color key="backgroundColor" red="0.9803921569" green="0.968627451" blue="0.9490196078" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-wash" firstAttribute="top" secondItem="launch-view" secondAttribute="top" id="wash-top"/>
                            <constraint firstItem="launch-wash" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" id="wash-bottom"/>
                            <constraint firstItem="launch-wash" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="wash-leading"/>
                            <constraint firstItem="launch-wash" firstAttribute="trailing" secondItem="launch-view" secondAttribute="trailing" id="wash-trailing"/>
                            <constraint firstItem="launch-lockup" firstAttribute="centerX" secondItem="launch-safe" secondAttribute="centerX" id="brand-center-x"/>
                            <constraint firstItem="launch-lockup" firstAttribute="centerY" secondItem="launch-safe" secondAttribute="centerY" constant="-70" id="brand-center-y"/>
                            <constraint firstItem="launch-lockup" firstAttribute="width" relation="lessThanOrEqual" secondItem="launch-safe" secondAttribute="width" constant="-48" id="brand-max-width"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchWash" width="8" height="1000"/>
        <image name="LaunchLockup" width="345" height="408"/>
    </resources>
</document>
